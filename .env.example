# Copy to .env.local (git-ignored). Never commit .env.local.
ANTHROPIC_API_KEY=
# Set to 1 to enable Live mode (needs a local python3). Leave unset on Vercel.
ALLOW_LIVE=
# Python interpreter for the runner. Default: python3
PYTHON_BIN=
# Keeps Next.js from sending anonymous telemetry (the package.json scripts set it too).
NEXT_TELEMETRY_DISABLED=1
