    "react-dom": "19.2.7",
    "react-plotly.js": "4.1.0",
    "zod": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.10",
